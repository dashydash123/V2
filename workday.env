# Copy this file to ".env" in the same folder as the script and fill it in.
# Keep .env out of email, shared drives and Git - it holds your token.

# --- Authentication: use ONE of the two ---
DATABRICKS_TOKEN=paste-your-personal-access-token-here
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# --- Source (defaults already match the ABI workspace) ---
DATABRICKS_HOST=adb-3060038306817150.10.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/13861ac29ff00f3e
DATABRICKS_CATALOG=brewdat_uc_people_prod
DATABRICKS_SCHEMA=gld_ghq_people_workday_tr

# --- Optional cutoff ---
# Leave blank for every leaver. Set yyyy-mm-dd to drop leavers who left
# before that date from the HR roster (raw sheets always keep everything).
TERMINATION_CUTOFF_DATE=

# --- Output ---
OUTPUT_DIR=output
# LOG_FILE=output/workday_hr_roster.log

# --- Rehire rule ---
# Someone still in the headcount view counts as employed even if the
# termination view holds a past date for them (a rehire).
# Set a number of days to treat very recent terminations as leavers anyway,
# which guards against headcount snapshot lag. 0 = headcount always wins.
REHIRE_GRACE_DAYS=0
